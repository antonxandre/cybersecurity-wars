# PromptSec Arena - Environment Variables Template
# Copy to .env and configure values before starting

PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://promptsec:promptsec_secret_pass@localhost:5432/promptsec_db?schema=public"

# Authentication & JWT Secrets (Change to cryptographically secure strings in production)
JWT_ACCESS_SECRET="promptsec-arena-access-secret-minimum-32-chars-secure"
JWT_REFRESH_SECRET="promptsec-arena-refresh-secret-minimum-32-chars-secure"

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN="http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000"

# LLM Providers (Optional for offline simulation)
VERTEX_AI_PROJECT_ID=""
OLLAMA_BASE_URL="http://localhost:11434"
